# Copy to .env (gitignored). Values here are fake.
# Bot token from BotFather. Used only by the set-webhook script, never by the handler.
TELEGRAM_BOT_TOKEN=123456:CHANGEME
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token. 1-256 chars of A-Z a-z 0-9 _ -.
# Generate one: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGEME
# Your numeric Telegram user id. Messages from anyone else are ignored silently.
TELEGRAM_ALLOWED_USER_ID=100000001
# Same database as packages/db/.env.
DATABASE_URL=postgresql://hisaab:CHANGEME@localhost:5433/hisaab
