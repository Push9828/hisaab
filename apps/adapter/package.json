{
  "name": "@hisaab/adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file=.env src/local.ts",
    "webhook:set": "tsx --env-file=.env scripts/set-webhook.ts",
    "webhook:set:prod": "tsx --env-file=.env.production scripts/set-webhook.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --external:pg-native --outfile=dist/lambda.cjs",
    "deploy:aws": "pnpm build && sam deploy"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1150.0",
    "@hisaab/core": "workspace:*",
    "@hisaab/db": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
