# Copy to .env (gitignored). Values here are fake.
# Connects as hisaab_dashboard, never the admin role. See packages/db/scripts/dashboard-role.sql.
DATABASE_URL=postgresql://hisaab_dashboard:CHANGEME@localhost:5433/hisaab
# Comma-separated. Anyone else is rejected; an empty list rejects everyone.
ALLOWED_EMAILS=owner@example.com
# This app's own address, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGEME
# Google Cloud console: OAuth client of type "Web application".
# Local redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME
