# Copy to .env (gitignored) and choose your own password.
# docker-compose.yml reads the POSTGRES_* values; drizzle-kit and the app read DATABASE_URL.
# Keep the two in step, and keep the password URL-safe.
POSTGRES_USER=hisaab
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=hisaab
DATABASE_URL=postgresql://hisaab:CHANGEME@localhost:5433/hisaab
# Test database for `pnpm test:db`. Must end in _test; it is created and wiped by the tests.
TEST_DATABASE_URL=postgresql://hisaab:CHANGEME@localhost:5433/hisaab_test
# Sarvam API key for the llm:accuracy and llm:keywords scripts. Optional: nothing else uses it.
SARVAM_API_KEY=

# Production (Supabase) for the `:prod` scripts, such as `db:migrate:prod`. Put this in .env.production (gitignored),
# not in .env. Use the Session pooler (port 5432, IPv4), not the direct db.<ref> host (IPv6-only)
# or the transaction pooler (6543). No ?sslmode / ssl* parameters: TLS is verified in code
# against Supabase's CA (src/supabase-ca.ts). The Lambda's secret holds the same URL.
# DATABASE_URL=postgresql://postgres.<project-ref>:CHANGEME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
