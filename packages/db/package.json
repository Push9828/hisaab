{
  "name": "@hisaab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:prod": "tsx --env-file=.env.production scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose -f ../../docker-compose.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f ../../docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@hisaab/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1"
  }
}
