{
  "name": "@hisaab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:up": "docker compose -f ../../docker-compose.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f ../../docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  },
  "dependencies": {
    "@hisaab/core": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  }
}
