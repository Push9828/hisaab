generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Money is BigInt paise. Balances are derived, never stored (hard rule 5).
// CHECK constraints live in the init migration SQL; Prisma cannot express them.

enum AccountKind {
  BANK
  CREDIT_CARD
  RECEIVABLE
  PAYABLE
  LOAN
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  SPLIT
  ADJUSTMENT
}

enum TxStatus {
  CONFIRMED
  NEEDS_REVIEW
}

model Account {
  id             String      @id @default(cuid())
  alias          String      @unique
  name           String
  kind           AccountKind
  openingBalance BigInt      @default(0)
  entries        Entry[]
  createdAt      DateTime    @default(now())
}

model Transaction {
  id          String    @id @default(cuid())
  type        TxType
  occurredAt  DateTime
  description String
  category    String?
  spendAmount BigInt    @default(0)
  status      TxStatus  @default(CONFIRMED)
  voidedAt    DateTime?
  channel     String
  externalId  String
  rawText     String
  entries     Entry[]
  createdAt   DateTime  @default(now())
  // Creation order. `undo` voids the highest non-voided seq.
  seq         Int       @unique @default(autoincrement())

  @@unique([channel, externalId])
}

model Entry {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String
  amount        BigInt
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([transactionId])
}

// One row per processed message that wrote something, claimed in the same DB
// transaction as the write. Covers `undo` and `open`, which create no Transaction.
model ProcessedMessage {
  channel    String
  externalId String
  createdAt  DateTime @default(now())

  @@id([channel, externalId])
}
